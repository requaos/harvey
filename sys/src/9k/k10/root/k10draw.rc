#!/boot/rc -m /boot/rcmain
# k10draw.rc — the embedded /boot/boot of the draw donor venue kernel
# (15-05, USPACE-08, D-04).  initcode.c pre-binds #c->/dev, #e/#ec->/env,
# #s->/srv and opens cons on fds 0/1/2 before exec'ing this script —
# never re-bind those here.  The -m flag on the shebang is NOT optional
# (devroot has no compiled-in rcmain — k10t1.rc's measured lesson), and
# the console output fans to BOTH the vga screen and the serial consdev
# (putstrn0's loop), so every marker below lands on the serial capture —
# the venue's only egress wire.

# path FIRST: rcmain's fallback default is (. /bin); with /boot first
# every bare command resolves to the embedded set.
path=(/boot /bin .)

# namespace setup — bare binds resolve to /boot/bind via the path just
# set (k10t1.rc's own idiom).  The device binds onto /dev are UNION
# binds (-a, MAFTER): a plain bind is MREPL and would REPLACE initcode's
# #c mount (measured on the first venue boot: /dev/time vanished behind
# #m and the boot script died).
bind '#p' /proc
bind '#d' /fd
bind -b /boot /bin
bind -a '#v' /dev
bind -a '#m' /dev

# venue plumbing the rc-script boot path otherwise skips (k10t1.rc's
# measured pair): set the kernel clock from the RTC, and name a
# hostowner BEFORE the draw/input choreography (writing #c/hostowner
# also sets the process user — the eve-gate on #c/kbin and #m/mousein
# depends on it).
cat '#r/rtc' > /dev/time
echo -n sys > '#c/hostowner'

# the -initrd payload channel: qemu registered the paq as an mb1 module,
# multiboot exposed it through addbootfile as /boot/bootfs-draw.paq (the
# `mod ...` boot print on the capture is the A2 evidence), and the
# tier-1-built paqfs mounts it OVER /mnt (the embedded root is read-only
# — mkdir is denied — so the paq rides an existing devroot mount point).
# The fonts (the WHOLE lib/font/bit tree, bake-time-copied) bind at /lib
# and the GUI binaries union into /bin.  /rc carries the STANDARD
# rcmain (staged in the paq): rc sources an rcmain UNCONDITIONALLY
# (15-02's srv -e lesson, re-measured on this venue — rio's window
# shell runs `rc -i`, acme's Execute and sam's !cmd run `rc -c`, and
# every one of them died sourcing the default /rc/lib/rcmain before
# this bind).  The writable /tmp scratch (the
# 15-06 trace fragments' home) is ramfs (host-built, staged in the paq):
# 15-05's `mntgen /tmp` was a wrong assumption measured dead in 15-06 —
# this tree's mntgen is a READ-ONLY synthetic mount-point generator
# (every walked name becomes a DMDIR|0555 entry; fsopen rejects every
# non-OREAD open and there is no create), so tracesup's fragment files
# were "create prohibited"; ramfs is the real in-memory filesystem.
paqfs -m /mnt /boot/bootfs-draw.paq
bind /mnt/lib /lib
bind /mnt/rc /rc
bind -b /mnt/amd64/bin /bin
ramfs

# FONT-CHANNEL-OK: rio's and acme's default fonts are stat-able in-guest
if(test -e /lib/font/bit/lucm/unicode.9.font && test -e /lib/font/bit/lucidasans/euro.8.font)
	echo FONT-CHANNEL-OK
if not
	echo FONT-CHANNEL-FAIL

# the VGA bring-up choreography (userspace-driven, devvga.c's verbs):
# type dispi arms the DISPI VGAdev (vgadispi.c's enable — the mode-set
# itself), linear maps the LFB through vgalinearpci (the soft-screen
# discipline: the LFB is the flush destination), size allocates the
# 1024x768x32 screen image and installs it for devdraw, drawinit
# completes the sequence (a no-op for dispi but the canonical verb).
echo type dispi > '#v/vgactl'
echo linear 16777216 > '#v/vgactl'
echo 'size 1024x768x32 x8r8g8b8' > '#v/vgactl'
echo drawinit > '#v/vgactl'

# #i LAST and only now: devdraw's ATTACH installs the screen image
# (drawattach -> initscreenimage -> attachscreen), so binding #i before
# the size verb fails the bind itself ("#i: no frame buffer" — measured
# on the first venue boot).  Union bind, initdraw's own MAFTER shape.
bind -a '#i' /dev

# the /dev/draw exerciser + the synthetic-input probes: /dev/draw/new
# opens, a fill image allocates, a rectangle paints, pixels read back
# (DRAW-SMOKE-OK); then the eve-gated #c/kbin round trip (KBIN-OK) and
# the #m/mousein position readback (MOUSEIN-OK) — the probes live in
# the exerciser (bounded waits in C; the rc console-interaction forms
# are the 15-02 dialect's least reliable corner, and a wedged read
# there wedges the whole boot — measured).  The four markers above are
# the venue's bring-up gate and stay IN FRONT of every 15-06 trace
# session: a capture without them never reaches the distiller.
drawsmoke

# the 15-06 trace mode: when the payload carries the trace-session
# driver (build-9kdraw.sh stages it beside the committed replay
# scripts), the scripted-interaction trace sessions run INSTEAD of the
# idle done-marker — the driver emits TRACE-VENUE-DONE and its own
# trailing DRAW-VENUE-DONE.  The plain venue paq (no trace-session.rc)
# keeps the 15-05 flow untouched.  The session runs in a child rc (its
# trailing exit never kills init), sourced from the boot flow, never
# typed.
if(test -f /lib/trace-session.rc)
	rc -m /boot/rcmain -c '. /lib/trace-session.rc'
if not
	echo DRAW-VENUE-DONE

# init must never exit (an exiting init panics the kernel —
# k10root.rc's idiom).
while(~ 1 1){ . -i '#d/0' }
