# the mount table boot built, so the paqfs tree must be re-attached at
# /root (via #s/boot — the devsrv entry boot's srvcreate posted) and
# re-bound onto / before any /root-prefixed bind can resolve.  Without
# this pair, the bin binds below fail soft and init's exec of /bin/rc
# stalls.

# re-mount the root server (the wiped table's reconstruction)
mount -a #s/boot /root
bind -a /root /

# kernel devices
bind #c /dev
bind #d /fd
bind -c #e /env
bind #p /proc
bind -c #s /srv

# standard bin
bind /root/$cputype/bin /bin
bind -a /root/rc/bin /bin
