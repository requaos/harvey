			echo 'CMP R7,$-1
			BNE 4(PC)
			MOVW a+0(FP),R8
			MOVW R7,0(R8)
			MOVW R7,4(R8)'
		}
		echo RETURN
	case arm
		echo TEXT $i'(SB)', 1, '$0'
		echo MOVW R0, '0(FP)'
		echo MOVW '$'$n, R0
		echo SWI 0
		if(~ $i seek || ~ $i nsec) {
			echo 'CMP $-1,R0
			BNE 4(PC)
			MOVW a+0(FP),R1
			MOVW R0,0(R1)
			MOVW R0,4(R1)'
		}
		echo RET
	case power
		echo TEXT $i'(SB)', 1, '$0'
		echo MOVW R3, '0(FP)'
		echo MOVW '$'$n, R3
		echo SYSCALL
		if(~ $i seek || ~ $i nsec) {
			echo 'CMP R3,$-1
			BNE 4(PC)
			MOVW a+0(FP),R8
			MOVW R3,0(R8)
			MOVW R3,4(R8)'
		}
		echo RETURN
