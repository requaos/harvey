</$objtype/mkfile

ALLTARG=factotum\
	fgui\

# D-13/USPACE-04 tier allowlist filter, dir:target level (the uniform
# keep-rule comment lives in sys/src/mkfile): a cmd/auth/factotum:<target>
# tier1 entry keeps only <target> here — fgui needs the out-of-tier graphics
# stack (libdraw/libcontrol).  Passthrough for every other objtype and under
# COVERAGE_SWEEP=1.
TIER1=$HARVEY/build/aarch64/tiers/tier1-cmds.txt
T1KEEPT=`{awk '/^cmd\/auth\/factotum:/{ sub(/^cmd\/auth\/factotum:/,""); sub(/[\/: 	].*$/,""); print }' $TIER1}
# 14-08 (XEXEC-04): the amd64 arm — build/x86_64/tiers (factotum the
# seeded target; fgui still excluded).  The aarch64 arm above stays
# as-is.
# 15-01 (USPACE-07): the amd64 keep widens to the tier1+tier2 UNION in
# ONE multi-file awk (defensive symmetry with the other filter sites —
# factotum itself stays a tier-1 line, never moved into tier 2).
# 15-04 (USPACE-08): widens again to tier1+tier2+tier3 in the same one
# call (defensive symmetry held; fgui stays excluded — see the tier
# data's named-exclusion record).
TIER1A=$HARVEY/build/x86_64/tiers/tier1-cmds.txt
TIER2A=$HARVEY/build/x86_64/tiers/tier2-services.txt
TIER3A=$HARVEY/build/x86_64/tiers/tier3-gui.txt
T1KEEPTA=`{awk '/^cmd\/auth\/factotum:/{ sub(/^cmd\/auth\/factotum:/,""); sub(/[\/: 	].*$/,""); print }' $TIER1A $TIER2A $TIER3A}

TARG=`{if(~ $objtype aarch64 && ! ~ $"COVERAGE_SWEEP 1) for(i in $ALLTARG) if(~ $i $T1KEEPT) echo $i; if not if(~ $objtype amd64 && ! ~ $"COVERAGE_SWEEP 1) for(i in $ALLTARG) if(~ $i $T1KEEPTA) echo $i; if not echo $ALLTARG}

PROTO=\
	apop.$O\
	chap.$O\
	httpdigest.$O\
	p9any.$O\
	p9cr.$O\
	p9sk1.$O\
	pass.$O\
	rsa.$O\
	wep.$O\
	wpapsk.$O\

FOFILES=\
	$PROTO\
	confirm.$O\
	fs.$O\
	log.$O\
	rpc.$O\
	util.$O\
	secstore.$O\

HFILES=\
	dat.h\

LIB=/$objtype/lib/libauth.a /$objtype/lib/libauthsrv.a
BIN=/$objtype/bin/auth

UPDATE=\
	mkfile\
	$HFILES\
	${FOFILES:%.$O=%.c}\
	fgui.c\

</sys/src/cmd/mkmany

$O.factotum: $FOFILES
	$LD -o $target $prereq

$O.fgui: fgui.$O
	$LD -o $target $prereq
