#!/bin/rc
# services-sweep.rc — the 15-02 USPACE-07 services functional-probe
# sweep (D-02/D-08 semantics): the tier1-sweep.rc shape extended from
# fixed-input checks to DAEMON probes.  A daemon earns its SVC-OK marker
# ONLY through a real client interaction through it (mntgen serves a
# walk-created directory, cs answers a scripted lookup via /net/cs, dns
# resolves a baked entry, exportfs serves a guest-side mount, listen's
# announce accepts a loopback connect, factotum answers a ctl probe,
# keyfs exercises the write-back-on-create, authsrv accepts the
# listener's per-connection exec) — a daemon that merely started is
# NEVER an OK.  Venue-impossible probes take named SVC-SKIP lines with
# the reason, never a weaker pass.
#
# ONE file, TWO venues: the k10t1 donor's k10t1.rc sources it after the
# tier-1 sweep (`. /boot/services-sweep.rc 9k' — the donor embed) and
# the r9 services image (15-03's bake) stages it at /lib/services-sweep.rc
# with services-termrc running `rc /lib/services-sweep.rc r9'.  Never
# typed on either venue (the sourced-from-the-boot-flow discipline).
#
#	usage: rc /lib/services-sweep.rc [venue]	venue: 9k (default) | r9
#
# Markers over serial (host asserts presence, never interleaving order;
# TCG-timing tolerant):
#	SVC-OK <name>	the daemon's functional probe passed
#	SVC-FAIL <name>	it failed — the sweep CONTINUES (a failing probe
#			never wedges or shortens the sweep)
#	SVC-SKIP <name>	a venue-honest skip — every potentially-emitted
#			SKIP is a declared `echo SVC-SKIP' line in this
#			file (the harness extracts that set verbatim and
#			asserts equality both directions)
#	SVC-DONE	the sweep ran to completion
#
# Never-wedge discipline (Pitfall 5): every daemon runs backgrounded
# and every readiness expectation is a BOUNDED spin (the svc_waitpath /
# svc_waitport helpers — sleep-bounded waits feeding SVC-FAIL arms); a
# wedged daemon classifies as SVC-FAIL when its spin expires, never a
# hang.  The client commands self-terminate by construction (echo
# one-shot services, query tools on stdin EOF, srv's internal 10s
# alarm), and the host harness's sweep budget is the backstop.
#
# Vocabulary discipline (the donor embed's h* names): EVERY command the
# sweep runs carries the $B/h* prefix EXCEPT the boot chain's three
# unprefixed embeds (rc, echo, bind — the second-name staged copies) —
# a bare `test' or `sleep' resolves to nothing on the donor (only
# /boot's htest/hsleep exist; measured on the first tracer boot: rc's
# "file does not exist" Xerror per call).
#
# rc-syntax discipline (measured on the donor, third tracer boot): `if
# not' takes a SIMPLE command only — a braced `if not {' body is a
# parse error that kills the whole sourced file mid-stream (rc parses
# each braced block whole before running it, so the failure looked like
# a silent wedge with no error line until the serial console was driven
# interactively).  Multi-step ladders below use flat status-variable
# conditions (`if(~ $var state)') instead of nested if/if-not chains.
#
# Venue facts this file rides (the donor, k10t1): the devroot embed is
# READ-ONLY — writable scratch is /env (devenv) for probe FILES and
# mntgen's walk-create mount for probe DIRECTORIES (mntgen /mnt, the
# repo's own rc/bin/termrc idiom; devroot has no /tmp and mkdir is not
# a tier member on x64).  The loopback leg binds #I at /net the 14-09
# netip-loopback shape (raw ipifc ctl writes — ipconfig is not a donor
# embed member) BEFORE any daemon that names a network: cs registers
# its network list by scanning /net/*/clone at startup (cs.c netinit —
# measured: without #I bound, `tcp' is an unknown network and the query
# falls through to the no-translation clone reply).  NO srv9, NO
# 9front tree, NO NIC: serial is the only egress and every probe is
# file/loopback-backed.

venue=$1
if(~ $#venue 0) venue=9k

# the sweep vocabulary: the h* embed names resolve through /bin (the
# boot script's `bind -b /boot /bin')
B=/bin

# aux/listen reads $cputype at startup (listen.c's getenv guard); the
# sweep exports it for every child (rc vars ride /env)
cputype=amd64

# svc_waitpath <iters> <path> — bounded existence spin (1s sleeps).
# True when the path appeared inside the budget, false when the spin
# expired (the caller's SVC-FAIL arm classifies the wedge/absence).  The
# counter rides a LIST append ($#n) — immune to the empty-substitution
# cascade a failed arithmetic backquote would cause.
fn svc_waitpath {
	n=()
	while(! $B/htest -e $2 && $B/htest $#n -lt $1){
		n=($n x)
		$B/hsleep 1
	}
	$B/htest -e $2
}

# svc_waitport <iters> <port> — bounded spin for an announced tcp
# listener conv (any /net/tcp/N/local carrying !<port>), the 14-09
# port-discovery shape.  Sets svcportfound (nonempty = found).  Same
# $#n counter discipline.
svcportfound=''
fn svc_waitport {
	n=()
	svcportfound=''
	while($B/htest $#n -lt $1 && ~ $svcportfound ''){
		for(d in /net/tcp/[0-9]*){
			loc=`{$B/hcat $d/local >[2]/dev/null}
			if(~ $"loc *!^$2)
				svcportfound=$d
		}
		if(~ $svcportfound ''){
			n=($n x)
			$B/hsleep 1
		}
	}
}

# --- mntgen: the mount-point provider (the sweep's bootstrap) ---------
# mntgen /mnt (the repo's termrc idiom) mounts the synthetic tree whose
# walk-create materializes every later probe's mount point (/mnt/keys,
# /mnt/factotum, the srv mounts).  The marker's interaction: a real
# client walk through the mount — hls's stat of a fresh name creates it
# (fswalk1's create-on-demand) and reads back its DMDIR — plus the
# posted /srv/mnttest.  The sweep's file scratch stays /env (mntgen's
# tree is read-only above the walk-create).
if($B/hmntgen -s mnttest /mnt){
	if($B/htest -e /srv/mnttest){
		dirout=`{$B/hls -ld /mnt/svcscratch}
		if(~ $"dirout d*) echo SVC-OK mntgen
		if not echo SVC-FAIL mntgen
	}
	if not echo SVC-FAIL mntgen
}
if not echo SVC-FAIL mntgen

# --- the loopback bring-up (the 14-09 netip-loopback shape verbatim) --
# bind #I at /net + one loopback ipifc carrying the 127.0.0.1 probe
# address: a TRANSIENT clone read for the conv number, then per-write
# ctl opens by path — exactly the fixture's own shape (its measured
# finding: the medium binding persists across ctl closes, the conv
# survives — no held fd needed on the ipifc side).  NO fd-dup machinery
# anywhere: Harvey rc's `<[n=m]' dup redirect is unreliable inside
# backquotes in nested sourced blocks (measured twice — see the
# discipline note above).  The bind must precede every daemon below:
# cs's netlist scan and dns's myipaddr both need the tree.  A failed
# bring-up degrades the net-dependent probes to their named SKIPs (the
# flagged assumption's honest landing — never a weaker pass).
svclo=''
if(bind -a '#I' /net){
	svclo=bound
}
if(~ $svclo ''){
	echo SVC-SKIP-WHY no-netdev-the-ip-device-bind-failed
	echo SVC-SKIP cs
}
if(~ $svclo bound){
	lconv=`{$B/hcat /net/ipifc/clone}
	if(~ $#lconv 1){
		if($B/htest -e /net/ipifc/$lconv/ctl){
			if($B/hecho bind loopback > /net/ipifc/$lconv/ctl){
				# TWO addresses on the one loopback ipifc: 127.0.0.1 for
				# the connects, plus a non-loopback probe address —
				# libip's myipaddr skips 127.0.0.0/8 and NEVER falls
				# back to loopback (measured: dns sysfatals "can't read
				# my ip address" on a loopback-only venue)
				if($B/hecho add 127.0.0.1 255.0.0.0 > /net/ipifc/$lconv/ctl){
					if($B/hecho add 192.168.237.1 255.255.255.255 > /net/ipifc/$lconv/ctl){
						svclo=up
					}
				}
			}
		}
	}
	if(~ $svclo up) echo SVC-LOOPBACK-UP
	if(! ~ $svclo up) echo SVC-LOOPBACK-NOT-UP
}

# --- cs: the connection server answers a scripted lookup --------------
# The test ndb rides /env (ip=… dom=probehost — a baked probe host,
# throwaway values only).  The value's closing quote sits on the NEXT
# LINE: the string carries a trailing newline, which libndb's Brdline
# parser REQUIRES (a final unterminated line is dropped whole —
# measured: the lookup missed on the correct content until the newline
# rode along).  hcs -f serves it mounted at /net/cs (its netlist scan
# sees /net/tcp/clone — the #I bind above); hcsquery is the canned
# client (csquery.c).  The query is cs's general ipinfo form — the
# measured route that exercises the ndb end-to-end: a `tcp!host!port'
# network translation takes the dns-first path (dnsiplookup) whose
# /srv/dns failure errstr swamps the successful ndb fallback, while
# `!ipinfo dom=probehost ip' answers straight from the ndb (measured
# live: `ip=127.0.0.1').  The marker rides the ANSWER carrying the
# baked address — never the daemon's start.  cs needs only the #I bind
# (its netlist), not the loopback address — it runs on $svclo=bound or
# up.
if(! ~ $svclo ''){
	# both baked hosts: cs's ipinfo lookup (dom=probehost) and dns's A
	# record (dom=probehost.test) — the trailing newline is load-bearing
	# (libndb drops an unterminated final line)
	svcndb='ip=127.0.0.1 dom=probehost
ip=127.0.0.1 dom=probehost.test
'
	$B/hcs -f /env/svcndb &
	if(svc_waitpath 10 /net/cs){
		qout=`{$B/hcsquery /net/cs '!ipinfo dom=probehost ip'}
		echo SVC-CSOBS $"qout
		# the assert pattern avoids `=' (rc's lexer rejects it inside a
		# bare word — measured: "token '=*ip': syntax error" killed the
		# whole sourced file); the probe host's address alone is unique
		# to the baked ndb
		if(~ $"qout *127.0.0.1*) echo SVC-OK cs
		if not echo SVC-FAIL cs
	}
	if not echo SVC-FAIL cs
}

# --- dns: the resolver answers a baked A record -----------------------
# hdns -f serves the test ndb; hdnsquery is the canned client — piped
# the fixed query, it self-mounts /srv/dns at /net and prints the
# answer.  dns REQUIRES the loopback address (its myipaddr sysfatals
# without a readable /net/ipselftab — measured upstream), so this probe
# and the listen probe below gate on $svclo=up and take their named
# SKIPs together when the venue cannot bring loopback up.
if(~ $svclo up){
	$B/hdns -f /env/svcndb &
	if(svc_waitpath 10 /srv/dns){
		# the piped query carries its NEWLINE (echo without -n):
		# dnsquery's Brdline starves on an unterminated final line
		dqout=`{$B/hecho 'probehost.test ip' | $B/hdnsquery}
		echo SVC-DNSOBS $"dqout
		if(~ $"dqout *127.0.0.1*) echo SVC-OK dns
		if not echo SVC-FAIL dns
	}
	if not echo SVC-FAIL dns
}

# --- exportfs + srv: a guest-side mount with content through it -------
# srv's -e exec helper hardcodes /bin/rc -c (srv.c connectcmd), and rc
# sources /rc/lib/rcmain on EVERY invocation — devroot has no /rc, so
# the child rc died at the default rcmain walk (measured: "can't open:
# '/rc'").  The bootstrap below satisfies it the namespace way: a
# second mntgen at /rc (walk-created dirs), then /boot bound -b at
# /rc/lib (the bind's own mount walk materializes the mount point
# through that mntgen) — /rc/lib/rcmain is then the embedded rcmain.
# hsrv -n -e execs hexportfs over its pipe, posts /srv/xprobe, and
# mounts the served tree at /mnt/xprobe (the kernel's mount walk
# materializes that mount point through the first mntgen's union).  The
# exportfs marker rides CONTENT compared through the mount — the tier-1
# sentinel byte-for-byte — and srv earns its own marker as the enabler
# whose exec+post+mount interaction IS the exchange.  srv's internal
# 10s alarm bounds the setup.
if($B/hmntgen /rc){
	if(bind -b /boot /rc/lib){
		svcr=ready
	}
}
if(! ~ $svcr ready) echo SVC-SKIP-WHY no-rc-lib-rcmain-the-srv-child-rc-dies
svcx=''
if(~ $svcr ready){
	if($B/hsrv -n -e 'hexportfs -r /boot' xprobe /mnt/xprobe){
		svcx=posted
	}
}
if(~ $svcx posted){
	if($B/hcmp /boot/sentinel.txt /mnt/xprobe/sentinel.txt){
		echo SVC-OK srv
		echo SVC-OK exportfs
	}
	if not echo SVC-FAIL exportfs
}
if(! ~ $svcx posted){
	echo SVC-FAIL srv
	echo SVC-FAIL exportfs
}

# --- listen: the announce accepts a real loopback connect -------------
# hlisten -q -t /boot tcp announces every /boot/tcpNNNN service (the
# staged-copy trick: tcp9901 IS echo under its service name — listen
# execes servdir/<proto><port> per connection).  The interaction: a
# one-shot client (hsvctcpecho, the compiled 15-02 helper) connects to
# 127.0.0.1!9901 and prints the line the per-connection service sent
# back through the connection.
if(~ $svclo up){
	$B/hlisten -q -t /boot tcp &
	svc_waitport 10 9901
	if(! ~ $svcportfound ''){
		lout=`{$B/hsvctcpecho 'tcp!127.0.0.1!9901'}
		echo SVC-LISTENOBS $"lout
		if(~ $"lout tcp9901*) echo SVC-OK listen
		if not echo SVC-FAIL listen
	}
	if not echo SVC-FAIL listen
}

# --- factotum: the ctl round-trip (D-08's start + answer) -------------
# hfactotum posts /srv/factotum and mounts its tree MBEFORE at /mnt
# (the fs root's single entry names /mnt/factotum).  The interaction:
# a throwaway test key written to ctl, then the ctl READBACK — the
# key list with the secret masked.  No real key material anywhere
# (dom=probe-style test values only, the security-domain rule).
if($B/hfactotum -s factotum){
	if(svc_waitpath 10 /mnt/factotum/ctl){
		if($B/hecho 'key proto=pass service=test user=probe !password=probe-only-test' > /mnt/factotum/ctl){
			kout=`{$B/hcat /mnt/factotum/ctl}
			echo SVC-FACTOBS $"kout
			# no bare '=' in the pattern (the lexer discipline)
			if(~ $"kout *proto*pass*) echo SVC-OK factotum
			if not echo SVC-FAIL factotum
		}
		if not echo SVC-FAIL factotum
	}
	if not echo SVC-FAIL factotum
}
if not echo SVC-FAIL factotum

# --- keyfs: the write-back-on-create over an absent test keyfile ------
# hkeyfs -m /mnt/keys with an ABSENT keyfile: readnvram's amd64->"pc"
# rows all target #S/nvram/9fat devices this venue does not have, and
# THIS tree's getauthkey escalates the failed readnvram into an
# INTERACTIVE Password prompt (getauthkey.c — readln opens /dev/cons
# by path; measured: the no-input harness venue wedges there — the
# zero-key+warning landing the plan projected lives one call lower,
# inside readnvram itself).  The probe isolates the interaction the
# namespace way: a one-line throwaway env file bound over /dev/cons
# for the keyfs run — readln's fresh opens read the same fixed line
# for the password AND its confirm (a chan's offset restarts at 0 per
# open), passtokey derives the throwaway machine key, and the prompt's
# own write merely rewrites the env file (harmless).  The bind stays
# for the venue lifetime: nothing after this probe opens /dev/cons
# fresh (the sweep's markers ride already-open fds; no unmount binary
# is embedded).  The interaction: hmkdir's DMDIR create through the
# mounted fs installs a probe user AND triggers writeusers — the
# write-back materializes the absent keyfile (observable in /env).
if(! $B/htest -e /env/svckeys){
	svckeyfscons=p
	if(bind /env/svckeyfscons /dev/cons){
		if($B/hkeyfs -m /mnt/keys /env/svckeys){
			if($B/hmkdir /mnt/keys/probeuser){
				if($B/htest -e /env/svckeys) echo SVC-OK keyfs
				if not echo SVC-FAIL keyfs
			}
			if not echo SVC-FAIL keyfs
		}
		if not echo SVC-FAIL keyfs
	}
	if not echo SVC-FAIL keyfs
}
if not echo SVC-FAIL keyfs

# --- authsrv: the listener topology's per-connection exec (D-08) ------
# tcp9902 IS authsrv under its service name (the staged-copy trick) —
# the SAME hlisten instance announced it with tcp9901.  D-08's shape:
# starts and LISTENS — the connect-accept is the proof (hsvctcpecho
# -c dials; an announced port accepts, an unannounced one refuses);
# the p9sk1 handshake itself is Phase 18's, never duplicated here.
if(~ $svclo up){
	svc_waitport 10 9902
	if(! ~ $svcportfound ''){
		aout=`{$B/hsvctcpecho -c 'tcp!127.0.0.1!9902'}
		echo SVC-AUTHOBS $"aout
		if(~ $"aout connected*) echo SVC-OK authsrv
		if not echo SVC-FAIL authsrv
	}
	if not echo SVC-FAIL authsrv
}

# the loopback-gated probes' shared named-SKIP arm (the flagged
# assumption's honest landing: 9k devip loopback is proven on this
# venue now, so this fires only if the bring-up regresses — the reason
# line names the cause either way)
if(! ~ $svclo up){
	echo SVC-SKIP-WHY k10t1-no-loopback
	echo SVC-SKIP dns
	echo SVC-SKIP listen
	echo SVC-SKIP authsrv
}

echo SVC-DONE
exit
