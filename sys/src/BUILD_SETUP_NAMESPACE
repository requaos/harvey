#!/usr/bin/sh
# when we get here, we are root.
# arg1 is our user ID, and arg2 is our environment.

mount --bind .. /sys

# ls -l /sys/include
# ls -l /sys/src
echo $1
echo $2
pwd
. $2
export
echo $PATH
which mk
ldd `which mk`

# no for loop here -- keep it shell-agnostic
# export objtype=amd64
mkdir -p /arm
mount --bind $HARVEY/arm /arm

mkdir -p /arm64
mount --bind $HARVEY/arm64 /arm64

mkdir -p /amd64
mount --bind $HARVEY/amd64 /amd64

mkdir -p /386
mount --bind $HARVEY/386 /386

mkdir -p /mips
mount --bind $HARVEY/mips /mips

mkdir -p /mips64
mount --bind $HARVEY/mips64 /mips64

mkdir -p /power
mount --bind $HARVEY/power /power

mkdir -p /power64
mount --bind $HARVEY/power64 /power64

mkdir -p /riscv
mount --bind $HARVEY/riscv /riscv

mkdir -p /riscv64
mount --bind $HARVEY/riscv64 /riscv64

mkdir -p /sparc
mount --bind $HARVEY/sparc /sparc

mkdir -p /acme
mount --bind $HARVEY/acme /acme

mkdir -p /rc
mount --bind $HARVEY/rc /rc

mkdir -p /mail
mount --bind $HARVEY/mail /mail

# /lib must show harvey's lib while keeping the distro runtime reachable.
# A plain bind of $HARVEY/lib over /lib (usrmerge: -> /usr/lib) hides the
# loader + libselinux/libpam/... and every distro binary then fails to exec.
# Stage a merged copy FIRST (while /lib is still intact — cp itself needs
# the loader), then bind it over. All of this vanishes when the mount
# namespace exits.
if [ -L /lib ]; then LIBREAL=$(readlink -f /lib); else LIBREAL=/lib; fi
NSLIB=/tmp/nslib.$$
mkdir -p $NSLIB
cp -a "$LIBREAL"/. $NSLIB/
cp -a $HARVEY/lib/. $NSLIB/
chmod 1777 $NSLIB	# build runs as non-root; allow mkdir /lib/audio etc.
mount --bind $NSLIB "$LIBREAL"

mkdir -p /unix
mount --bind $HARVEY/unix /unix

mkdir -p /usr/glenda
mount --bind $HARVEY/usr/glenda /usr/glenda

echo su  $1 bash BUILD $2
su -c ./BUILD $USER

# unwind the staged /lib
umount "$LIBREAL" 2>/dev/null || true
rm -rf "$NSLIB"
