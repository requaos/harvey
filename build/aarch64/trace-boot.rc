#!/bin/rc
# trace-boot.rc — guest-side real-chain trace driver (05-03 Task 1).
# Staged into the donor kernel's CONF=qemu bootdir as DATA (mkrootall
# strips only file-identified executables; text rides through) and run
# at the donor's rc prompt by harness trace-syscalls --boot-chain:
#
#	rc /boot/trace-boot.rc chain	trace the real boot chain
#	rc /boot/trace-boot.rc sweep	trace the standalone sweep binaries
#
# chain: launches /boot/ourboot (05-02's aarch64 boot(8)) with the embed
# method aimed at /boot/ourbootfs.paq — the REAL flow measured on the
# donor kernel: opencons → bindenvsrv → doauth (glenda path: the donor
# devroot's /boot/factotum is covered by a bind onto '#c/null' so
# access(AEXEC) fails exactly as on r9, D-02) → rfork(RFNAMEG) →
# connectembed (pipe+fork+exec /boot/paqfs — overridden to OUR aarch64
# paqfs by the driver's bind) → fversion → mount /root → nsinit binds
# → execinit → /aarch64/init -t (from the image via the / union) →
# newns → termrc (stacksmoke first, D-15) → exec rc -i → the % prompt.
#
# The staging binds + env writes run in THIS shell (the untraced
# driver).  They must NOT live in the traced launcher: rc has no bind
# builtin, so a bind forks /bin/bind — and a traced process's fork
# children are born traced (donor sysproc.c:155) and self-stop at their
# first syscall, wedging the launcher in Await before anyone arms the
# child.  For the same reason the launcher is a PLAIN brace group —
# `@{...}` is rc's subshell operator and would fork a born-traced
# grandchild inside the traced pid.  And the script rfork n's first
# (private namespace COPY): the chain's bind/mount traffic (opencons,
# bindenvsrv, nsinit's / union…) would otherwise land in the donor
# shell's own namespace and break the sweep phase's view.  The env group
# stays shared — the seeds use the '#e' DEVICE path, immune to the
# chain's /env rebinds.
#
# Tracing (04-01's recipe, extended): one startsyscall loop per pid,
# fragments re-emitted one tagged line each (the donor's entry fragments
# carry no trailing newline — concurrent raw cats would glue entries
# mid-line).  Born-traced children are armed in strict birth order by
# pidwait -w + traceloop1 (read the pending fragment BEFORE the first
# startsyscall resume):
#   1. the connectembed child (fork→dup×2→exec /boot/paqfs — dup is a
#      required measured name);
#   2. paqfs's OWN fork child — paqfs always rforks its server and the
#      parent exits (the stdio path: "don't deadlock if child fails"), so
#      the 9P service is the grandchild's stream, not /boot/paqfs's;
#   3. init's fexec child (the rc-to-be, named "init" pre-exec).
# A sweeper resumes any OTHER traced-born stopped process (rc's command
# children during the host-driven sweep, named "rc" pre-exec) so the
# interactive rc never wedges on an unarmed child; ourboot/init-named
# stopped processes are left for pidwait.
# The watchdog mainline waits for the host's `exit` at our rc, lets
# init's restart loop run long enough for sleep(17) to be captured,
# then kills the chain; every loop ends on Eprocdied.
#
# sweep: the D-09 sweep binaries + stacksmoke, each launched under a
# spin-armed subshell and step-traced to exit (the 04-01 shape).

mode = $1

# pure-compute spin: a forked subshell makes no syscalls while looping
# over lists, so this gives the arming `echo stop` a syscall-free window
# (nested: 60×60 concat iterations ≈ a few hundred ms under TCG)
spinelem = (a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a)
fn spin {
	x = ''
	for (a in $spinelem)
		for (b in $spinelem)
			x = $b^$x
}

# traceloop PID TAG — the 04-01 startsyscall recipe: each write blocks
# until the target's next stop; the fragment is then read from
# /proc/N/syscall; the target's EXITS breaks the write (Eprocdied).
# fragprint re-emits every fragment as ONE newline-terminated line with
# a per-pid tag: the donor's entry fragments carry no trailing newline
# (sysretfmt's return fragment supplies it), so raw cat output from
# concurrent loops glues entries mid-line and line-anchored host parsing
# would lose them (dup is a singleton pair — not losable).  sed tags
# byte-exactly (rc backquote+echo would re-split and quote empty words).
fn fragprint {
	cat /proc/$1/syscall | sed 's/^/__GSD_FRAG_'^$1^'__/'
}

fn traceloop {
	while (echo startsyscall > /proc/$1/ctl)
		fragprint $1
	echo __GSD_LOOP_DONE_^$2^__
}

# traceloop1 — for born-traced pids: the self-stop already left the
# first (entry) fragment pending in /proc/N/syscall; read it BEFORE the
# first startsyscall resume or it is overwritten unread.
fn traceloop1 {
	fragprint $1
	traceloop $1 $2
}

# sweeplive — resume any traced-born stopped process not in the
# exclusion list ($*).  rc's command children inherit tracing and
# self-stop at their first syscall; without this the interactive sweep
# wedges at its first fork (termrc's stacksmoke included).  Dies when
# the chain's pid 1 ($1) is gone.
fn sweeplive {
	while (test -d $1) {
		for (p in /proc/[0-9]*) {
			if (! ~ $p $*) {
				s = `{cat $p/status >[2]/dev/null}
				if (~ $s(3) Stopped)
					echo start > $p/ctl >[2]/dev/null
			}
		}
		spin
	}
}

# snapshot the donor's own rc/init pids — never armed or killed by us
donorcs = ()
donorinits = ()
for (p in /proc/[0-9]*) {
	s = `{cat $p/status >[2]/dev/null}
	if (~ $s(1) rc)
		donorcs = ($donorcs $p)
	if (~ $s(1) init)
		donorinits = ($donorinits $p)
}

if (~ $mode chain) {
	echo __GSD_CHAIN_LAUNCH__
	# private namespace copy FIRST: the chain's bind/mount traffic must
	# not land in the donor shell's namespace (it is shared by default)
	rfork n
	# the donor's own boot posted its root-fs connection as #s/boot;
	# our boot's srvcreate("boot", fd) is FATAL on the collision — remove
	# the donor's entry first (the mounted donor root holds its own chan
	# reference and keeps working; init's newns replay then re-mounts
	# #s/boot = OUR paqfs pipe at /root — the 9k flow).
	rm /srv/boot >[2]/dev/null
	# stage the overrides + seeds: our paqfs answers the embed method's
	# exec of /boot/paqfs; the donor devroot's factotum is covered so
	# access(AEXEC) fails exactly as on r9 (D-02); the trace namespace
	# file is bound over /lib/namespace so init's newns replays it (the
	# open precedes the RFCNAMEG wipe).  The seeds use the '#e' DEVICE
	# path — immune to the chain's /env rebinds; #e/init must be REMOVED
	# (the donor's bootrc leaks init="/arm64/init -t" into the shared
	# env group, and execinit prefers $init over the cputype branch —
	# we measure the cputype branch, the r9-faithful one).
	bind /boot/ourpaqfs /boot/paqfs
	bind '#c/null' /boot/factotum
	bind /boot/ournamespace /lib/namespace
	rm '#e/init' >[2]/dev/null
	echo -n aarch64 > '#e/cputype'
	echo -n 'embed!/boot/ourbootfs.paq' > '#e/nobootprompt'
	# the launcher: nothing but spin + exec inside the traced pid.
	{
		spin
		exec /boot/ourboot
	} &
	bootpid = $apid
	echo stop > /proc/$bootpid/ctl
	traceloop $bootpid boot &
	looppids = (/proc/^$apid)
	echo __GSD_ARM_boot_^$bootpid^__
	# the connectembed child: fork→dup×2→close×2→exec paqfs, born
	# traced and self-stopped at its first syscall; -w waits for the
	# stop so the pending entry fragment survives.  (The pid rides
	# stdout — a non-empty exit status would arrive kernel-decorated
	# as "name pid: status", pexit.)
	cpid = `{/boot/pidwait -w ourboot $bootpid >[2]/dev/null}
	if (! ~ $cpid [0-9]*) {
		echo __GSD_CHILD_ARM_FAILED_^$cpid^__
		exit childarm
	}
	traceloop1 $cpid paqfs &
	looppids = ($looppids /proc/^$apid)
	echo __GSD_ARM_paqfs_^$cpid^__
	# paqfs's own fork child — the actual 9P server (the stdio path's
	# parent exits right after the fork, by design)
	srvpid = `{/boot/pidwait -w paqfs /proc/$cpid >[2]/dev/null}
	if (! ~ $srvpid [0-9]*) {
		echo __GSD_SRV_ARM_FAILED_^$srvpid^__
		exit srvarm
	}
	traceloop1 $srvpid srv &
	looppids = ($looppids /proc/^$apid)
	echo __GSD_ARM_srv_^$srvpid^__
	# init's fexec child (the rc-to-be), born traced, named init
	rcpid = `{/boot/pidwait -w init /proc/$bootpid $donorinits >[2]/dev/null}
	if (! ~ $rcpid [0-9]*) {
		echo __GSD_RC_ARM_FAILED_^$rcpid^__
		exit rcarm
	}
	traceloop1 $rcpid rc &
	looppids = ($looppids /proc/^$apid)
	echo __GSD_ARM_rc_^$rcpid^__
	echo __GSD_CHAIN_ARMED__
	# the sweeper (spawned only now: rc subshells get a var COPY at
	# fork, so every armed pid must exist first; the exclusions ride as
	# args, all normalized to /proc/N paths)
	sweeplive /proc/$bootpid /proc/$cpid /proc/$srvpid /proc/$rcpid $looppids $donorcs $donorinits &
	sweeppid = $apid
	# watchdog: oursweep.rc ends with exit → rc dies → init's restart
	# loop runs — wait long enough for sleep(1000) to be entered (its
	# entry is captured) before killing the chain
	while (test -d /proc/$rcpid)
		sleep 1
	sleep 2
	# release the posted pipe: #s/boot holds the connectembed pipe's p[0]
	# chan in the global srv registry even after boot dies — without the
	# removal the server's pipe read never sees the hangup
	rm /srv/boot >[2]/dev/null
	# guarded kills: paqfs's main line exits right after forking its
	# server (by design), so its /proc entry is gone — an unguarded
	# redirect error would abort the whole script
	for (v in $bootpid $cpid $srvpid)
		if (test -e /proc/$v/ctl)
			echo kill > /proc/$v/ctl >[2]/dev/null
	# init may have respawned rc before dying — kill any new rc (named
	# "rc" post-exec, "init" pre-exec; the born-traced self-stop holds
	# it until the sweeper starts it — kill pends, start delivers)
	for (p in /proc/[0-9]*) {
		if (! ~ $p /proc/$bootpid /proc/$cpid /proc/$srvpid /proc/$rcpid $looppids $donorcs $donorinits) {
			s = `{cat $p/status >[2]/dev/null}
			if (~ $s(1) rc init) {
				if (test -e $p/ctl)
					echo kill > $p/ctl >[2]/dev/null
				if (test -e $p/ctl)
					echo start > $p/ctl >[2]/dev/null
			}
		}
	}
	# restore the shared env group (the driver's seeds hit it too) via
	# the device path — the script's /env may be rebound by the chain
	echo -n arm64 > '#e/cputype' >[2]/dev/null
	echo __GSD_CHAIN_DONE__
	exit
}

if (~ $mode sweep) {
	for (n in ourecho ourls ourps ourcat ourstacksmoke) {
		echo __GSD_SWEEP_BEGIN_^$n^__
		{
			spin
			if (~ $n ourecho)
				exec /boot/ourecho __GSD_SWEEP_ECHO_OUT__
			if (~ $n ourls)
				exec /boot/ourls /bin
			if (~ $n ourps)
				exec /boot/ourps
			if (~ $n ourcat)
				exec /boot/ourcat /boot/trace-boot.rc > /dev/null
			if (~ $n ourstacksmoke)
				exec /boot/ourstacksmoke
		} &
		tpid = $apid
		echo stop > /proc/$tpid/ctl
		while (echo startsyscall > /proc/$tpid/ctl)
			fragprint $tpid
		echo __GSD_SWEEP_DONE_^$n^__
	}
	echo __GSD_ALL_DONE__
	exit
}

echo 'usage: rc /boot/trace-boot.rc chain|sweep' >[1=2]
exit usage
