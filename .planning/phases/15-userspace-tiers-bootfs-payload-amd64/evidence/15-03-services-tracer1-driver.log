			MOVW R8,0(R9)
			MOVW R8,4(R9)'
		}
		if(~ $i nsec) {
			echo 'MOVW a+0(FP),R10
			MOVW R8,0(R10)
			MOVW R9,4(R10)'
		}
		echo RET
	case riscv64
		if(~ $i seek)
			echo TEXT _seek'(SB)', 1, '$0'
		if not
			echo TEXT $i'(SB)', 1, '$0'
