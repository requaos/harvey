# /usr/glenda/lib/profile — the D-17 trimmed cpu-aware profile (15-08),
# staged in the committed root-tree skeleton (the DESK-03 payload's
# profile half; trimmed from usr/glenda/lib/profile, the trim source
# read verbatim):
#   - the mail-filesystem start (source line 7) and the
#     message-of-the-day calls (source lines 28 and 35 — the cpu AND
#     con cases) dropped; this comment names neither command, so the
#     gate's whole-file grep for them stays mechanically clean
#   - the terminal case keeps the binds/tmp/font (lines 1-6, shared)
#     but LOSES `exec rio -i riostart' — rio must provably NOT start at
#     boot (the serial-console venue); its plumber + '#m/mousectl'
#     writes are dropped with it: no devmouse or plumber substrate
#     exists on the serial image and a failed redirect RAISES in rc
#     (the 15-02 measured dialect) — a future draw-terminal venue
#     re-derives its own mouse/plumbing bring-up
#   - the cpu case stays INTACT except two GUARDED 19-07 additions
#     (DESK-02/DESK-05): the window-manager exec sits behind a
#     draw-presence guard (test -e /mnt/term/dev/draw — a text-mode
#     -G session has no draw device and stays a plain cpu% shell
#     instead of dying at the exec; boot never runs the profile at
#     all, so the desktop is provably in-session only), and plumber
#     starts in-session before it under the same guard
bind -a $home/bin/rc /bin
bind -a $home/bin/$cputype /bin
bind -c tmp /tmp
if(! syscall create /tmp/xxx 1 0666 >[2]/dev/null)
	ramfs	# in case we're running off a cd
font = /lib/font/bit/pelm/euro.9.font
fn cd { builtin cd $* && awd }  # for acme
switch($service){
case terminal
	prompt=('term% ' '	')
	fn term%{ $* }
case cpu
	# rio already running?  TWO shapes: terminal-side rio at
	# /mnt/term/mnt/wsys (the stock drawterm idiom), and REMOTE rio —
	# this venue's desktop, whose window shells see /mnt/wsys (winshell's
	# own mount, fsys.c filsysmount).  Either way this shell is inside a
	# desktop: bind the wsys dev tree and NEVER start a second one
	# (the second rio is the 19-10 Leg-1 ghost — it steals /dev/mouse
	# from the real desktop and the mouse chain dies post-sweep).
	wsysup=()
	if (test -e /mnt/term/mnt/wsys)
		wsysup=1
	if (test -e /mnt/wsys)
		wsysup=1
	if (test -e /mnt/wsys)
		bind -a /mnt/wsys /dev
	if (test -e /mnt/term/mnt/wsys)
		bind -a /mnt/term/mnt/wsys /dev
	if (test -w /dev/label)
		echo -n $sysname > /dev/label
	bind /mnt/term/dev/cons /dev/cons
	bind /mnt/term/dev/consctl /dev/consctl
	bind -a /mnt/term/dev /dev
	prompt=('cpu% ' '	')
	fn cpu%{ $* }
	if (~ $#wsysup 0) {	# cpu call from drawterm — no desktop anywhere
		font=/lib/font/bit/pelm/latin1.8.font
		if (test -e /mnt/term/dev/draw) {	# the client serves draw — the in-session desktop (DESK-02: guarded, so a text-mode -G session stays a plain cpu% shell instead of dying at the exec)
			plumber	# in-session plumbing before the window manager (DESK-05)
			exec rio
		}
	}
case con
	prompt=('cpu% ' '	')
}
