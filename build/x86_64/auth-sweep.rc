#!/bin/rc
# auth-sweep.rc — the 18-04 AUTH domain bring-up sweep (AUTH-04/D-02/
# D-03/D-04): the services-sweep.rc shape (15-02's donor-proven
# disciplines) re-keyed onto the baked p9sk1 domain.  The sweep runs
# from the boot flow (auth-termrc's `rc /lib/auth-sweep.rc r9' — init
# sources the termrc; never typed, both venues' single source).
#
# Legs (in emission order; each prints its OWN markers — the host gate
# presence-asserts them, never interleaving order):
#	leg 1	the D-02 BOOT pairing check — BEFORE keyfs, always:
#		recompute sha1 over /adm/nvram, /adm/keys, /lib/ndb/auth
#		against /adm/domain.manifest's rows (in-guest sha1sum,
#		tier-1); pass prints `authdom: PAIRED <label>' (D-04 —
#		the label from the manifest's label row), ANY mismatch
#		prints `authdom: FAIL <artifact>' and SKIPS every later
#		leg (fail-loud; the termrc still reaches exec rc -i so
#		serial shows why — a headless gate must NEVER wedge
#		behind keyfs's interactive machine-key prompt)
#	leg 2	mntgen /mnt + the nvram= env assignment + NON-
#		interactive keyfs (NO -p: the nvram= path — readnvram's
#		getenv("nvram") -> plain file, safeoff 0, 109-byte
#		Nvrsafe read; keyfs prints its own `N keys read' and
#		mounts /mnt/keys) -> `AUTH-OK keyfs'
#	(18-04 Task 2/3 append: the loopback bring-up + the listener
#	 topology (listen1 -t tcp!*!567 /amd64/bin/authsrv -d +
#	 secstored -v), cs over the baked default /lib/ndb/local, and
#	 factotum with norbert's p9sk1 key.)
#	leg 7	(18-05) the p9sk1 probe window: the sentinel bound over
#		/dev/cons, auth/debug run as norbert (factotum's key
#		drives it) — its OWN `ticket request using norbert@'
#		success line, filtered-captured (T-18-13: only the
#		matching line echoes, `AUTH-DEBUGOBS <line>') ->
#		`AUTH-OK p9sk1-norbert'
#	leg 8	(18-05, same window) hauthprobe's speaksfor arms: the
#		pass arm (hostid=bootes uid=norbert, decrypt with the
#		speaker's key, suid==norbert -> `authprobe:
#		SPEAKSFOR-OK bootes for norbert') -> `AUTH-OK speaksfor';
#		the deny arm ONCE (uid=sys, the baked uid=!sys row — the
#		scrambled reply fails to decrypt -> `authprobe:
#		SPEAKSFOR-DENIED sys', the EXPECTED negative control;
#		never a loop — Pitfall 4) -> `AUTH-OK speaksfor-deny';
#		then the console restored (the '#c/cons' re-bind) for
#		the later secstore leg's getpassm -> `AUTH-CONSOLEOBS
#		restored'
#	leg 9	(18-05) the secstore substrate (AUTH-08/D-14): secuser
#		creates norbert's account through the writable venue
#		(the two getpassm passwords console-fed by the host
#		gate — getpassm is NOT sentinel-drivable; the four field
#		prompts read the cooked console line-by-line —
#		userinput's whole-chunk reads coalesce a file feed, so
#		/dev/cons IS the stdin) -> `AUTH-OK secuser'; the client
#		PUT/GET round-trip is the named SKIP arm: r9's devip
#		never delivers SConn's two-write pattern (the donor
#		client's 2-byte count + payload writes stall with both
#		procs parked; the one-write control round-trips —
#		evidence/18-05-secstore-stall-modes.console.log) —
#		KERNEL bytes, pinned, outside this plan; -> `AUTH-SKIP
#		secstore-roundtrip' + `AUTH-SKIP-WHY r9-devip-two-write-
#		tcp' (the 15-08 venue-honesty lineage: a SKIP with its
#		reason, never an unearned OK; the prohibition holds —
#		no secstore green without the bytes-back round-trip)
#
# Marker vocabulary (the host gate's contract): `authdom: PAIRED
# <label>', `authdom: FAIL <artifact>', `AUTH-OK <leg>', `AUTH-FAIL
# <leg>', `AUTH-DEBUGOBS <line>' (leg 7's filtered success line),
# `AUTH-CONSOLEOBS restored|sentinel-still-bound' (the window's
# cleanup status), `AUTH-VENUEOBS <verdict>' (leg 9a's probe
# outcome), `AUTH-SECOBS <bytes>' (the delivered round-trip content),
# `AUTH-DONE' (every leg green; a failed sweep terminates in
# `AUTH-FAIL sweep' so the gate's fast-fail arm localizes without a
# timeout stall).
#
# rc-syntax discipline (15-02's measured list, carried verbatim):
# braced `if not {' bodies are parse errors that kill a sourced file
# mid-stream — ONLY the tier1/services sweeps' proven shapes appear:
# a same-line single command under `if(...)' (positively or negatively
# conditioned), `if not cmd' same-line, and a braced TRUE arm
# (optionally negated: `if(! cond){ ... }') for multi-line bodies.  A
# bare `=' ends a word (the nvram= assignment below is safe EXACTLY
# because it stands alone on its own line; =-bearing argv is always
# single-quoted); NO fd-dup redirects inside nested sourced blocks.
# Sourced-not-typed on every venue.
#
# Vocabulary discipline (the services contract's §11b lineage): every
# command the sweep runs carries the $B/h* prefix except `bind' (the
# 14-09 utility supply, staged unprefixed) and rc's own builtins —
# the h* names resolve through /bin (the namespace's
# `bind /root/$cputype/bin /bin').
#
#	usage: rc /lib/auth-sweep.rc [venue]	venue: r9 (default)

venue=$1
if(~ $#venue 0) venue=r9
B=/bin

# svc_waitpath <iters> <path> — bounded existence spin (1s sleeps).
# True when the path appeared inside the budget, false when the spin
# expired (the caller's AUTH-FAIL arm classifies the wedge/absence).
# The counter rides a LIST append ($#n) — immune to the empty-
# substitution cascade a failed arithmetic backquote would cause.
fn svc_waitpath {
	n=()
	while(! $B/htest -e $2 && $B/htest $#n -lt $1){
		n=($n x)
		$B/hsleep 1
	}
	$B/htest -e $2
}

# svc_waitport <iters> <port> — bounded spin for an announced tcp
# listener conv (any /net/tcp/N/local carrying !<port>), the 14-09
# port-discovery shape.  Sets svcportfound (nonempty = found).  Same
# $#n counter discipline.
svcportfound=''
fn svc_waitport {
	n=()
	svcportfound=''
	while($B/htest $#n -lt $1 && ~ $svcportfound ''){
		for(d in /net/tcp/[0-9]*){
			loc=`{$B/hcat $d/local >[2]/dev/null}
			if(~ $"loc *!^$2)
				svcportfound=$d
		}
		if(~ $svcportfound ''){
			n=($n x)
			$B/hsleep 1
		}
	}
}

# --- leg 1: the D-02 boot pairing check (BEFORE keyfs — always) ------
# The manifest is the generator's own 5-row shape (18-03: `label <t>',
# `users <n>', one `<sha1>  <name>' row per artifact — strictly three
# artifact rows: nvram, keys, ndb-auth): ten whitespace-separated
# words when hcat splits it.  Flat ladder, one compare per artifact —
# the in-guest sha1sum word ($sum(1)) against the manifest's row
# position; rc's `~' does exact matching on the hex (no glob chars in
# a sha1).  ANY mismatch names the artifact and skips every later leg.
man=`{$B/hcat /adm/domain.manifest}
pairfail=''
if(! ~ $#man 10) pairfail=manifest
if(~ $pairfail ''){
	if(! ~ $man(1) label) pairfail=manifest
}
if(~ $pairfail ''){
	if(! ~ $man(3) users) pairfail=manifest
}
if(~ $pairfail ''){
	if(! ~ $man(6) nvram) pairfail=manifest
}
if(~ $pairfail ''){
	if(! ~ $man(8) keys) pairfail=manifest
}
if(~ $pairfail ''){
	if(! ~ $man(10) ndb-auth) pairfail=manifest
}
if(~ $pairfail ''){
	sumnv=`{$B/hsha1sum /adm/nvram}
	if(! ~ $sumnv(1) $man(5)) pairfail=nvram
}
if(~ $pairfail ''){
	sumkeys=`{$B/hsha1sum /adm/keys}
	if(! ~ $sumkeys(1) $man(7)) pairfail=keys
}
if(~ $pairfail ''){
	sumndb=`{$B/hsha1sum /lib/ndb/auth}
	if(! ~ $sumndb(1) $man(9)) pairfail=ndb-auth
}
if(~ $pairfail '') echo authdom: PAIRED $man(2)
if(! ~ $pairfail ''){
	echo authdom: FAIL $pairfail
	echo AUTH-FAIL pairing
}

# --- leg 2: mntgen + the nvram= env + NON-interactive keyfs ----------
# mntgen mounts /mnt FIRST (the repo termrc's own idiom — the mount
# walk through its union materializes /mnt/keys).  nvram= is a PLAIN
# assignment on its own line — the only safe form (the 15-02 measured
# lexer rule) — and it MUST precede the keyfs line: keyfs's server
# rfork carries RFENVG, so the child sees a COPY of the env at fork
# time (Pitfall 8).  NO -p flag: the -p path is getpass (interactive);
# the nvram path is readnvram -> getenv("nvram") -> plain 109-byte
# file at safeoff 0 — prompt-free by construction when the pairing
# held (a valid five-sum Nvrsafe never consults the nvtab fallback).
# keyfs itself prints `N keys read' (its own load line); the sweep's
# observable is the mounted /mnt/keys tree inside a bounded spin.
keyfsstat=fail
if(~ $pairfail ''){
	if($B/hmntgen /mnt){
		nvram=/adm/nvram
		if($B/hkeyfs -m /mnt/keys /adm/keys){
			if(svc_waitpath 10 /mnt/keys) keyfsstat=ok
		}
	}
}
if(~ $keyfsstat ok) echo AUTH-OK keyfs
if not echo AUTH-FAIL keyfs

# --- leg 3: the loopback bring-up (the 14-09 netip-loopback shape) ----
# The services sweep's bring-up block verbatim (its own measured
# findings ride): bind #I at /net (r9's sys_bind needs the mount point,
# staged empty), then ONE loopback ipifc — a transient clone read for
# the conv number, per-write ctl opens by path (the medium binding
# persists across ctl closes; NO fd-dup machinery anywhere) — carrying
# 127.0.0.1 plus a SECOND non-loopback probe address (libip's myipaddr
# skips 127.0.0.0/8 and never falls back; a later consumer measured
# sysfatal on a loopback-only venue).  Raw ctl writes: no ipconfig in
# this image, none needed.  The bind must precede every daemon below
# (cs's netlist scan, the listeners' announces).
authlo=''
if(bind -a '#I' /net){
	authlo=bound
}
if(~ $authlo bound){
	lconv=`{$B/hcat /net/ipifc/clone}
	if(~ $#lconv 1){
		if($B/htest -e /net/ipifc/$lconv/ctl){
			if($B/hecho bind loopback > /net/ipifc/$lconv/ctl){
				if($B/hecho add 127.0.0.1 255.0.0.0 > /net/ipifc/$lconv/ctl){
					if($B/hecho add 192.168.237.1 255.255.255.255 > /net/ipifc/$lconv/ctl){
						authlo=up
					}
				}
			}
		}
	}
}
if(~ $authlo up) echo AUTH-LOOPBACK-UP
if not echo AUTH-FAIL loopback

# --- leg 3b: the writable secstore venue, mounted BEFORE the listeners
# (moved ahead of leg 4's daemon starts so the per-connection children
# — whose namespace snapshots at the listener's fork — see the mount by
# construction regardless of pgrp-sharing semantics).  ramfs MREPL|MCREATE
# over the staged /adm/secstore mount point; the venue decision rides the
# recorded evidence (15-06's measured mntgen FILE-write refusal,
# re-confirmed live this phase: `devmnt: directory opens OREAD only',
# captured in the phase evidence — rc's redirect-open failures are FATAL
# to a sourced sweep, so an in-sweep mntgen probe cannot fail
# gracefully); the LIVE probe below proves the ramfs venue
# (create+write+read through the mount — the verdict marker every gate
# run re-proves).  Residual: if ramfs itself ever refuses, the sweep
# dies at the probe line and the gate's venue stage localizes by
# timeout.
venue=''
if($B/hramfs -m /adm/secstore){
	if($B/hecho venueprobe > /adm/secstore/venueprobe){
		vout=`{$B/hcat /adm/secstore/venueprobe}
		if(~ $"vout venueprobe){
			venue=ramfs
			echo AUTH-VENUEOBS ramfs-file-write-ok
		}
	}
}

# --- leg 4: the listener topology (D-09/D-10) -------------------------
# listen1 -t tcp!*!567 /amd64/bin/authsrv -d: -t is the TRUSTED arm —
# listen1.c's becomenone() (a #c/user write + newns("none")) would
# strip the namespace authsrv needs (/mnt/keys, /lib/ndb/auth); flags
# ride via listen1's exec(argv[1], argv+1) — the staged-copy listener
# (aux/listen) execs bare binaries and CANNOT pass -d (Pitfall 7).
# Without -v listen1 parks its own stdout on /dev/null — fine: the
# AUTH-07 visibility is authsrv -d's syslog lines (tr-ok/tr-fail
# family), which reach serial through libc syslog's #c/cons fallback
# (read-only paqfs makes /sys/log/auth unopenable — never create one,
# Pitfall 6).  secstored -v announces tcp!*!5356 self-contained and
# stays foreground-verbose inside the background rc job; its own
# syslog ANNOUNCE line lands on serial the same way.  The probes:
# bounded port spins over /net/tcp/*/local, then the connect-accept —
# hsvctcpecho -c dials 127.0.0.1!567 (the accept is the proof; the
# per-connection authsrv sees EOF and exits cleanly; a dial without a
# working cs falls back to the direct clone call — dial.c's
# no-connection-server path, so leg 4 runs before cs exists).
lststat=fail
secstat=fail
if(~ $authlo up){
	$B/hlisten1 -t 'tcp!*!567' /amd64/bin/authsrv -d &
	$B/hsecstored -v &
	svc_waitport 10 567
	if(! ~ $svcportfound ''){
		lout=`{$B/hsvctcpecho -c 'tcp!127.0.0.1!567'}
		echo AUTH-LISTENOBS $"lout
		if(~ $"lout connected*) lststat=ok
	}
	svc_waitport 10 5356
	if(! ~ $svcportfound '') secstat=ok
}
if(~ $lststat ok) echo AUTH-OK authsrv-listen
if not echo AUTH-FAIL authsrv-listen
if(~ $secstat ok) echo AUTH-OK secstored
if not echo AUTH-FAIL secstored

# --- leg 5: cs answers authdom->auth from the baked local (AUTH-05) ---
# cs runs with its DEFAULT database — the baked /lib/ndb/local, no -f
# (OQ3's resolution; ndbopen(nil) opens /lib/ndb/local).  The query is
# cs's generic pair form: `!authdom=DEMO-harvey auth=*' answers
# STRAIGHT from the ndb (dns never intercepts non-dom/ip keys —
# cs.c's genquery), and the AUTH-05 proof is the ANSWER carrying the
# composed auth=127.0.0.1 (a real client interaction through /net/cs,
# never file-presence).  The single-quoted =-bearing argv is the 15-02
# proven form; the assert pattern avoids bare `=' (the lexer rule).
csstat=fail
if(~ $authlo up){
	$B/hcs &
	if(svc_waitpath 10 /net/cs){
		qout=`{$B/hcsquery /net/cs '!authdom=DEMO-harvey auth=*'}
		echo AUTH-CSOBS $"qout
		if(~ $"qout *127.0.0.1*) csstat=ok
	}
}
if(~ $csstat ok) echo AUTH-OK cs
if not echo AUTH-FAIL cs

# --- leg 6: factotum carrying norbert's p9sk1 key (the 18-05 substrate)
# hfactotum -s factotum posts /srv/factotum and mounts MBEFORE at /mnt
# (the sweep-proven shape).  The key write: proto=p9sk1 user=norbert
# dom=DEMO-harvey + the DEMO-shared password from the baked sentinel
# feed (/boot/authfeed.txt — single line, the generator's own last-user
# copy; the ^ concatenation keeps the = inside the single-quoted part,
# the 15-02/15-07 measured rule).  The read-back assert: the ctl
# listing carries the p9sk1 key (factotum masks the !password — the
# proto/user/dom trio is the observable).
factstat=fail
authpw=`{$B/hcat /boot/authfeed.txt}
if(~ $#authpw 1){
	if($B/hfactotum -s factotum){
		if(svc_waitpath 10 /mnt/factotum/ctl){
			$B/hecho 'key proto=p9sk1 user=norbert dom=DEMO-harvey !password='^$authpw > /mnt/factotum/ctl
			kout=`{$B/hcat /mnt/factotum/ctl}
			echo AUTH-FACTOBS $"kout
			if(~ $"kout *proto*p9sk1*) factstat=ok
		}
	}
}
if(~ $factstat ok) echo AUTH-OK factotum
if not echo AUTH-FAIL factotum

# --- leg 7: auth/debug — the FULL p9sk1 challenge-response as norbert
# (18-05 leg 1, AUTH-06/D-13): the read-only sentinel bound over
# /dev/cons for the whole probe window (the 15-02 keyfs technique) —
# auth/debug's readln prompts each open /dev/cons FRESH and read the
# shared DEMO password line (every fresh OREAD restarts at offset 0 of
# the bound file).  The bootes-owner cooked prompt eats the same line
# as harmless noise (A4: its answer becomes tr.authid and that leg's
# ticket2 fails to decrypt — diagnostics only, the FIRST test's
# success line is the marker).  The capture is filtered BEFORE echo:
# ONLY the matching success line reaches serial (T-18-13 — the noise
# leg's prompt text embeds the sentinel answer; the password never
# lands in a marker line or the log).  The newline-only ifs makes the
# backquote split into LINES, so the loop pattern matches whole lines,
# never cross-line fragments — and it STAYS newline-only for the rest
# of the sweep (a save/restore of the default ifs is lossy through
# rc's assignment-time splitting, measured live: the saved copy came
# back empty; every later backquote here is line-granular by design).
# The echoed line keeps auth/debug's leading tab — the host gate's
# pattern is whitespace-class tolerant for exactly that reason.
p9sk1stat=fail
sfstat=fail
denystat=fail
consrestored=''
if(~ $factstat ok){
	if(bind /boot/authfeed.txt /dev/cons){
		nl='
'
		ifs=$nl
		dout=`{$B/hdebug}
		for(l in $dout){
			if(~ $l *'ticket request using norbert@'*){
				echo AUTH-DEBUGOBS $l
				p9sk1stat=ok
			}
		}
# --- leg 8: the speaksfor arms (18-05 leg 2, AUTH-06/D-13) — hauthprobe
# inside the SAME sentinel window (its readcons password reads the same
# feed line).  Pass arm: Ticketreq hostid=bootes uid=norbert (the
# speaks-for wire form stock auth/debug cannot send) — authsrv's
# speaksfor() consults the baked /lib/ndb/auth rows, the reply decrypts
# with the SPEAKER's key and carries suid=norbert -> its own
# `authprobe: SPEAKSFOR-OK bootes for norbert' on serial (fd 1 — the
# inherited console, not /dev/cons by path).  Deny arm, ONCE (Pitfall 4:
# the zero-clock lockout is permanent — never loop failures): uid=sys
# hits the baked uid=!sys deny row, authsrv scrambles the keys
# (anti-enumeration), the reply fails to decrypt -> its own
# `authprobe: SPEAKSFOR-DENIED sys' (the EXPECTED negative-control
# output; the host gate counts it, exactly once).
		if($B/hauthprobe 127.0.0.1 DEMO-harvey bootes norbert) sfstat=ok
		if($B/hauthprobe -d 127.0.0.1 DEMO-harvey bootes sys) denystat=ok
# --- the window's cleanup: the console restored for fresh /dev/cons
# opens — the sentinel REPLACED by a bind of the device's own cons
# (plain bind replaces the mount at that point; '#c' attach bypasses
# the namespace).  secuser's getpassm (the later secstore leg) opens
# /dev/cons ORDWR by path and sysfatals under a read-only sentinel —
# without this restore the secstore leg is structurally dead.
		if(bind '#c/cons' /dev/cons) consrestored=yes
	}
}
if(~ $p9sk1stat ok) echo AUTH-OK p9sk1-norbert
if not echo AUTH-FAIL p9sk1-norbert
if(~ $sfstat ok) echo AUTH-OK speaksfor
if not echo AUTH-FAIL speaksfor
if(~ $denystat ok) echo AUTH-OK speaksfor-deny
if not echo AUTH-FAIL speaksfor-deny
if(~ $consrestored yes) echo AUTH-CONSOLEOBS restored
if not echo AUTH-CONSOLEOBS sentinel-still-bound

# --- leg 9: the secstore round-trip (18-05, AUTH-08/D-14) --------------
# 9a. (the venue mounted at leg 3b — BEFORE the listeners.)  secuser
# creates norbert's secstore account through the venue; the client PUT
# and the -G GET complete the round-trip.
# 9b. secuser creates norbert's secstore account.  getpassm opens
# /dev/cons ORDWR + sysfatals under a read-only sentinel (util.c:42-48)
# — the leg REQUIRES the leg-8 console restore, and its two password
# prompts are console-fed by the host gate (expect matches the prompt
# text on serial and sends the per-bake DEMO password — R9_DEMO_PW,
# the 14f2b host-side feed copy; raw mode, so the password never
# echoes to the wire).  stdin IS /dev/cons for the field prompts too:
# secuser's userinput reads whole-chunk reads that coalesce a FILE
# feed into one buffer (measured from the code — read(0, buf, 128)
# over a file returns every line at once), so the line-granular COOKED
# CONSOLE is the only venue that delivers one answer per prompt; the
# gate types the four pinned field answers (default expiry — the
# zero-clock-safe +365d default; E; N; empty comment) after matching
# each prompt.  secuser itself creates who/ + store/ through the venue
# (ensure_exists).
secuserstat=fail
if(! ~ $venue ''){
	if($B/hsecuser -v norbert < /dev/cons){
		secuserstat=ok
	}
}
# 9c. the client PUT/GET round-trip: BLOCKED on this venue — the named
# SKIP arm (the 15-08 venue-honesty lineage: a SKIP with its reason,
# never an unearned OK — the prohibition holds: NO secstore green
# without the bytes-back round-trip).  Root cause (measured live this
# phase, evidence/18-05-secstore-stall-modes.console.log): r9's devip
# loopback TCP never delivers SConn's donor write pattern — a 2-byte
# count write immediately followed by the payload write
# (secstore/SConn.c SC_write) stalls with BOTH procs parked (the
# client's read-park drive never lands the pair; an alarm note does
# not reach a devip-blocked proc either).  The one-write control
# round-trips (a single 33-byte write got PAKserver's framed error
# reply back through the same two-write server path), so the defect is
# the two-write client pattern class in r9's devip seam — KERNEL
# bytes, pinned at b2a6151, outside this plan's authority.  The
# venue's substrate stays PROVEN green: ramfs mount + file probe
# (leg 3b) + the account creation (9b's AUTH-OK secuser — the who
# entry + who/store dirs through the writable venue, console-fed
# passwords).  Reopener: the next r9 kernel-byte pass (Phase 19's cpu
# path rides multi-write TCP too); unblocking = fix devip, then
# restore 9d below (the committed shape: copy the payload into the
# venue, PUT with CWD there, -G GET, grep the payload line —
# AUTH-OK secstore-roundtrip only on the delivered bytes).
if(~ $secuserstat ok) echo AUTH-SKIP-WHY r9-devip-two-write-tcp
if(~ $secuserstat ok) echo AUTH-SKIP secstore-roundtrip
if(~ $secuserstat ok) echo AUTH-SKIP secstore-put
if not echo AUTH-FAIL secuser
if(~ $secuserstat ok) echo AUTH-OK secuser

# 9d. (BLOCKED — the SKIP arm above; restore on the devip fix)

# --- the terminal marker (AUTH-DONE only on a fully-green sweep) -----
sweepstat=ok
if(! ~ $pairfail '') sweepstat=fail
if(! ~ $keyfsstat ok) sweepstat=fail
if(! ~ $authlo up) sweepstat=fail
if(! ~ $lststat ok) sweepstat=fail
if(! ~ $secstat ok) sweepstat=fail
if(! ~ $csstat ok) sweepstat=fail
if(! ~ $factstat ok) sweepstat=fail
if(! ~ $p9sk1stat ok) sweepstat=fail
if(! ~ $sfstat ok) sweepstat=fail
if(! ~ $denystat ok) sweepstat=fail
if(! ~ $consrestored yes) sweepstat=fail
if(! ~ $secuserstat ok) sweepstat=fail
if(~ $sweepstat ok) echo AUTH-DONE
if not echo AUTH-FAIL sweep
exit
