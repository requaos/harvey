</$objtype/mkfile

# sys/src/9k/boot/mkfile.aarch64 — the additive, objtype-gated aarch64
# boot(8) build for the r9 boot chain.  boot has no
# standalone mkfile: the amd64 path builds it from the kernel build dir
# via ../mk/bootmkfile with an awk-generated bootconf (../mk/parse
# -mkbootconf against the kernel config).  With no kernel config for r9,
# the hand-written bootr9.c supplies the bootconf instead.
#
# Invoked from the namespace build:
#	objtype=aarch64 mk -f mkfile.aarch64
# (driven by build/aarch64/subset-build.sh's boot-chain section).  The
# default target leaves the `boot` binary in the cwd; subset-build.sh
# harvests it to build/aarch64/out/boot.  boot is pid 1, not a user
# command — there is deliberately no install rule into /$objtype/bin.
#
# BOOTFILES is bootmkfile's archive list trimmed to the real 7l link
# closure of the embed-only method table:
#   - paq.$O is the lone trim: configpaq/connectpaq serve only the
#     flash-ramdisk method our table never names, and nothing else in
#     the closure references them.
#   - bootcache.$O stays: not for cache() (cfs is nil) but for statbuf,
#     which settime.c and local.c extern from boot.h.
#   - bootip.$O stays: local.c's connectlocalfossil calls configip, and
#     usb.c's runv pulls local.c into the link.
#   - printstub.$O is linked explicitly (never via the archive) so its
#     _fmtlock/_fmtunlock/_efgfmt stubs beat libc's fmt members at link
#     resolution — the same reason bootmkfile names it on the link line.

BOOTLIB=libboot.a$O

BOOTFILES=\
	bootauth.$O\
	aux.$O\
	boot.$O\
	bootcache.$O\
	bootip.$O\
	local.$O\
	embed.$O\
	settime.$O\
	parts.$O\
	usb.$O\

all:V:	boot

$BOOTLIB(%.$O):N:	%.$O

$BOOTLIB:	${BOOTFILES:%=$BOOTLIB(%)}
	names=`{membername $newprereq}
	ar vu $BOOTLIB $names
	rm $names

$BOOTFILES:	boot.h

%.$O:	%.c
	$CC -I. $CFLAGS $stem.c

boot:	bootr9.$O printstub.$O $BOOTLIB
	$LD -o boot bootr9.$O $BOOTLIB printstub.$O

clean:V:
	rm -f *.[$OS] $BOOTLIB boot
