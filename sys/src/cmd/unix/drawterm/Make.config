AUDIO=none
include $(ROOT)/Make.$(CONF)

# GUI=none: the gui-none no-window backend (the -G stdio session; the
# AUDIO=none class — a none member of the GUI set, see gui-none/).
# It needs none of the graphics wiring the OS file set, so strip the
# X11 include and the X11/Carbon link tails; make CONF=<os> GUI=none
# selects it.
ifeq ($(GUI),none)
CFLAGS:=$(filter-out -I$(X11)/include -m32,$(CFLAGS))
LDADD:=$(PTHREAD) -ggdb
LDFLAGS:=$(filter-out -m32,$(LDFLAGS))
endif
